# ==============================================================================
# BIO-BRAMHA DEALER MITRA - MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
#
# INSTRUCTIONS FOR CLIENT:
# 1. Copy this file and name it `.env.local` in your root project folder:
#      cp .env.example .env.local
# 2. Fill in the COMPULSORY values below before starting the application.
# 3. In Vercel / Production Deployment, add these exact environment variables in:
#      Project Settings -> Environment Variables
#
# ==============================================================================
# 1. DATABASE CONFIGURATION (SUPABASE)
# ==============================================================================
# Where to find: Supabase Dashboard -> Project Settings -> API (URL and Keys)

# [COMPULSORY] Your Supabase Project REST API URL (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# [COMPULSORY] Public Anon / Publishable Key for client-side queries
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# [COMPULSORY] Supabase Secret Service Role Key (Required for server-side admin APIs)
# NEVER share or expose this key in public client repositories.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here


# ==============================================================================
# 2. SMS & OTP AUTHENTICATION (MSG91)
# ==============================================================================
# Where to find: MSG91 Dashboard (https://control.msg91.com/)

# [COMPULSORY] MSG91 Authentication AuthKey
NEXT_PUBLIC_MSG91_AUTH_KEY=549591AtzGH4cg6a5a01e6P1
MSG91_AUTH_KEY=549591AtzGH4cg6a5a01e6P1

# [COMPULSORY] MSG91 OTP Flow Template ID
NEXT_PUBLIC_MSG91_TEMPLATE_ID=6a59ce32c9fa66b2d5069333
MSG91_TEMPLATE_ID=6a59ce32c9fa66b2d5069333

# [COMPULSORY] MSG91 Approved DLT Header / Sender ID
NEXT_PUBLIC_MSG91_SENDER_ID=DMTRA
MSG91_SENDER_ID=DMTRA


# ==============================================================================
# 3. SECURITY & SESSION MANAGEMENT
# ==============================================================================

# [COMPULSORY] 64-character Hexadecimal Secret for signing and validating JWT tokens.
# You can generate a fresh secure key using terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-64-character-hex-secret-here


# ==============================================================================
# 4. MOBILE APP / APK API URL (FOR CAPACITOR BUILDS)
# ==============================================================================

# [OPTIONAL for local dev / COMPULSORY for APK builds]
# Point this to your live production web domain so the mobile APK talks to your backend API.
# Example: https://bio-bramha.vercel.app
NEXT_PUBLIC_API_BASE_URL=https://your-production-domain.vercel.app


# ==============================================================================
# 5. ENVIRONMENT MODE
# ==============================================================================

# [OPTIONAL] Runtime environment mode ('development' or 'production')
NODE_ENV=development
